{
  "name": "doodle-studio-classroom",
  "private": true,
  "version": "0.1.0",
  "description": "Doodle Studio for Classroom: a Chrome extension that turns a teacher's script into a hand-drawn video and posts it to Google Classroom.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@mediabunny/aac-encoder": "1.60.0",
    "@met4citizen/headtts": "1.3.0",
    "mediabunny": "1.60.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
